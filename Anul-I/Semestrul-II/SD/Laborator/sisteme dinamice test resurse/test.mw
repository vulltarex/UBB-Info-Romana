<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#ex2restart;with(DEtools):with(plots):ecdif:=x^2*diff(y(x),x,x)+2*x*diff(y(x),x)+4*y(x)=0;sol:=dsolve(ecdif);yy:=unapply(rhs(sol),x);cond_in:=yy(1)=0,D(yy)(1)=1;sol_ec:=solve({yy,cond_in});c1:=2*sqrt(15)/15;c2:=0;yyy:=x-&gt;((c1*sin(sqrt(15)*ln(x)))/2)/sqrt(x)+(((c2*cos(sqrt(15)*ln(x)))/2)/sqrt(x);</Text-field>
</Input>
