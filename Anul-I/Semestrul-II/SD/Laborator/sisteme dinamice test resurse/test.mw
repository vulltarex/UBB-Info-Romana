<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#ex 1restart;with(DETools):ecdif:=x*diff(y(x),x)+k*y(x)=x^4+y(x);dsolve(ecdif,y(x));cond_in:=y(1)=1/(k+3);sol:=dsolve({ecdif,cond_in});yy:=unapply(rhs(sol),x);ec:=yy(3)=81;k:=solve(ec);</Text-field>
</Input>
