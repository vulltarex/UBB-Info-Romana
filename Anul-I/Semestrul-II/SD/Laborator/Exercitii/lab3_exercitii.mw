<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#ex 3.a
restart;
with(DEtools):
with(plots):
ec1:=diff(x(t),t)=x(t)+y(t);
ec2:=diff(y(t),t)=-2*x(t)+4*y(t);
sist:=ec1,ec2;
cond1:=x(0)=3,y(0)=0;
cond2:=x(0)=0,y(0)=3;
cond3:=x(0)=-3,y(0)=0;
cond4:=x(0)=0,y(0)=-3;
sol1:=dsolve({sist,cond1},{x(t),y(t)});
sol2:=dsolve({sist,cond2},{x(t),y(t)});
sol3:=dsolve({sist,cond3},{x(t),y(t)});
sol4:=dsolve({sist,cond4},{x(t),y(t)});
#ex 3.b
xx1:=unapply(rhs(sol1[1]),t);
yy1:=unapply(rhs(sol1[2]),t);
xx2:=unapply(rhs(sol2[1]),t);
yy2:=unapply(rhs(sol2[2]),t);
xx3:=unapply(rhs(sol3[1]),t);
yy3:=unapply(rhs(sol3[2]),t);
xx4:=unapply(rhs(sol4[1]),t);
yy4:=unapply(rhs(sol4[2]),t);
limit(xx1(t),t=infinity);
limit(yy1(t),t=infinity);
limit(xx2(t),t=infinity);
limit(yy2(t),t=infinity);
limit(xx3(t),t=infinity);
limit(yy3(t),t=infinity);
limit(xx4(t),t=infinity);
limit(yy4(t),t=infinity);
#ex 3.c
DEplot([sist],[x(t),y(t)],t=-5..5,x=-10..10,y=-10..10,[[cond1],[cond2],[cond3],[cond4]],arrows=medium,linecolor=[red,green,blue,black]);</Text-field>
