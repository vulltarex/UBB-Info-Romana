<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="seminar9.controller.MovieController"
            stylesheets="@style.css"
            prefWidth="760" prefHeight="420">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets bottom="16"/></padding>
            <Label text="Movie Management" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Add movie" styleClass="primary" onAction="#onAdd"/>
            <Button fx:id="updateButton" text="Edit" onAction="#onUpdate"/>
            <Button fx:id="deleteButton" text="Delete" styleClass="danger" onAction="#onDelete"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="movieTable">
            <placeholder><Label text="No movies yet"/></placeholder>
            <columns>
                <TableColumn sortable="false" fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn sortable="false" fx:id="titleColumn" text="TITLE" prefWidth="220"/>
                <TableColumn sortable="false" fx:id="directorColumn" text="DIRECTOR" prefWidth="180"/>
                <TableColumn sortable="false" fx:id="yearColumn" text="YEAR" prefWidth="80"/>
                <TableColumn sortable="false" fx:id="durationColumn" text="DURATION (MIN)" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="16"/></padding>
            <Button fx:id="previousButton" text="‹ Previous" onAction="#onPrevious"/>
            <Label fx:id="pageLabel" styleClass="muted"/>
            <Button fx:id="nextButton" text="Next ›" onAction="#onNext"/>
            <TextField fx:id="searchBar" promptText="Cautare..." onAction="#onSearch"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Sort by" styleClass="muted"/>
            <ComboBox fx:id="sortFieldBox" onAction="#onSortChanged"/>
            <ComboBox fx:id="sortDirectionBox" onAction="#onSortChanged"/>
        </HBox>
    </bottom>
</BorderPane>
